{
  "manifest_version": 3,
  "name": "PromptVault — Save prompts from any AI chat",
  "short_name": "PromptVault",
  "version": "1.0.0",
  "description": "Save and reuse your best AI prompts. One click to save from Claude, ChatGPT, Gemini & more — with title, text and source link.",
  "homepage_url": "https://mohamedashrafelsaed.com/projects/prompt-vault/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PromptVault — saved prompts",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://chat.mistral.ai/*",
        "https://www.meta.ai/*",
        "https://huggingface.co/chat/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
